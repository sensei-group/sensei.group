+// Only initialize when web config is actually present. `getAuth` throws
+// `auth/invalid-api-key` at *module scope* otherwise, which 500s every page that
+// merely renders the auth widget. Unconfigured => auth actions fail at their
+// point of use rather than taking the whole site down.
+const hasWebConfig = !!firebaseConfig.apiKey && !!firebaseConfig.projectId
+const firebaseApp = hasWebConfig
+  ? (getApps().length === 0 ? initializeApp(firebaseConfig) : getApps()[0])
